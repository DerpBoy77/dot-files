configuration {
    modi: "drun,run,window,filebrowser";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "󰍉 Apps";
    display-run: "󰌌 Run";
    display-window: "󰖲 Windows";
    display-filebrowser: "󰉋 Files";
    drun-display-format: "{name}";
    window-format: "{w} · {c} · {t}";
    font: "JetBrainsMono Nerd Font Propo 11";
}

/* Import Wallust colors */
@import "~/.cache/wallust/colors-rofi.rasi"

* {
    /* Global Defaults */
    background-color: transparent;
    text-color: @foreground;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 600px;
    background-color: @background;
    border: 1px solid;
    border-color: @color0;
    border-radius: 16px;
    padding: 16px;
}

mainbox {
    background-color: transparent;
    spacing: 12px;
    children: [inputbar, message, listview];
}

/* ---------------------------------------------------------
   SEARCH INPUT BAR (Translucent Card Style)
   --------------------------------------------------------- */
inputbar {
    background-color: @color0;
    text-color: @foreground;
    border-radius: 12px;
    padding: 10px 14px;
    spacing: 10px;
    children: [prompt, entry];
}

prompt {
    background-color: transparent;
    text-color: @color4;
}

entry {
    background-color: transparent;
    text-color: @foreground;
    placeholder: "Search...";
    placeholder-color: @color8;
}

/* ---------------------------------------------------------
   MESSAGE BOX
   --------------------------------------------------------- */
message {
    background-color: @color0;
    border: 1px solid;
    border-color: @color4;
    border-radius: 12px;
    padding: 10px 14px;
}

textbox {
    background-color: transparent;
    text-color: @color4;
}

/* ---------------------------------------------------------
   LISTVIEW (Fixed 8 Lines)
   --------------------------------------------------------- */
listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    fixed-height: true;
    spacing: 4px;
    border: 0;
}

element {
    background-color: transparent;
    padding: 8px 12px;
    border-radius: 8px;
    spacing: 10px;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element normal.urgent {
    background-color: transparent;
    text-color: @color1;
}

element normal.active {
    background-color: transparent;
    text-color: @color4;
}

/* Selected Items (Accent Pill with Dark Text) */
element selected.normal {
    background-color: @color4;
    text-color: @background;
}

element selected.urgent {
    background-color: @color1;
    text-color: @foreground;
}

element selected.active {
    background-color: @color2;
    text-color: @background;
}

element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element alternate.urgent {
    background-color: transparent;
    text-color: @color1;
}

element alternate.active {
    background-color: transparent;
    text-color: @color4;
}

element-icon {
    background-color: transparent;
    size: 24px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

/* ---------------------------------------------------------
   SCROLLBAR
   --------------------------------------------------------- */
scrollbar {
    handle-width: 4px;
    handle-color: @color4;
    background-color: transparent;
    border-radius: 4px;
    margin: 0 0 0 6px;
}